{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["shared/**/*.js", "threejs/src/**/*.js", "pixijs/src/**/*.js", "bench/**/*.js"],
  "exclude": ["**/node_modules", "**/dist"]
}
